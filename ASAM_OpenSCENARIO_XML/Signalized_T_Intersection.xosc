<?xml version="1.0" encoding="UTF-8"?>
<OpenSCENARIO xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="OpenSCENARIO.xsd">
  <FileHeader author="" date="2026-03-10T20:01:47" description="" revMajor="1" revMinor="4">
  </FileHeader>
  <ParameterDeclarations>
    <ParameterDeclaration name="VehicleSpeeds" parameterType="double" value="8.333">
      <ConstraintGroup>
        <ValueConstraint rule="greaterOrEqual" value="0" />
        <ValueConstraint rule="lessOrEqual" value="10" />
      </ConstraintGroup>
    </ParameterDeclaration>
    <ParameterDeclaration name="brokenState" parameterType="string" value="on;off;on"></ParameterDeclaration>
  </ParameterDeclarations>
  <CatalogLocations />
  <RoadNetwork>
    <LogicFile filepath="../ASAM_OpenDRIVE/Signalized_T_Intersection.xodr" />
    <TrafficSignals>
      <TrafficSignalController name="straight">
        <Phase name="red" semantics="stop" duration="30">
          <TrafficSignalGroupState state="on;off;off" />
        </Phase>
        <Phase name="intermediate_red" semantics="stop" duration="5">
          <TrafficSignalGroupState state="on;off;off" />
        </Phase>
        <Phase name="intermediate_to_green" semantics="attention_go" duration="1">
          <TrafficSignalGroupState state="on;on;off" />
        </Phase>
        <Phase name="green" semantics="go" duration="30">
          <TrafficSignalGroupState state="off;off;on" />
        </Phase>
        <Phase name="intermediate_to_red" semantics="attention_stop" duration="3">
          <TrafficSignalGroupState state="off;on;off" />
        </Phase>
        <Phase name="intermediate_red_pre" semantics="stop" duration="3">
          <TrafficSignalGroupState state="on;off;off" />
        </Phase>
      </TrafficSignalController>
      <TrafficSignalController name="turn">
        <Phase name="green" semantics="go" duration="30">
          <TrafficSignalGroupState state="off;off;on" />
        </Phase>
        <Phase name="intermediate_to_red" semantics="attention_stop" duration="3">
          <TrafficSignalGroupState state="off;on;off" />
        </Phase>
        <Phase name="intermediate_red_pre" semantics="stop" duration="3">
          <TrafficSignalGroupState state="on;off;off" />
        </Phase>
        <Phase name="red" semantics="stop" duration="30">
          <TrafficSignalGroupState state="on;off;off" />
        </Phase>
        <Phase name="intermediate_red_post" semantics="stop" duration="5">
          <TrafficSignalGroupState state="on;off;off" />
        </Phase>
        <Phase name="intermediate_to_green" semantics="attention_go" duration="1">
          <TrafficSignalGroupState state="on;on;off" />
        </Phase>
      </TrafficSignalController>
    </TrafficSignals>
  </RoadNetwork>
  <Entities>
    <ScenarioObject name="Vehicle 1">
      <Vehicle name="Vehicle 1" vehicleCategory="car">
        <ParameterDeclarations />
        <BoundingBox>
          <Center x="1.3" y="0.0" z="0.75" />
          <Dimensions width="1.8" length="4.5" height="1.5" />
        </BoundingBox>
        <Performance maxSpeed="70.0" maxDeceleration="10.0" maxAcceleration="10.0" />
        <Axles>
          <FrontAxle positionZ="0.4" trackWidth="1.68" positionX="2.98" maxSteering="0.5235987756" wheelDiameter="0.8" />
          <RearAxle positionZ="0.4" trackWidth="1.68" positionX="0.0" maxSteering="0.5235987756" wheelDiameter="0.8" />
        </Axles>
        <Properties />
      </Vehicle>
    </ScenarioObject>
    <ScenarioObject name="Vehicle 2">
      <Vehicle name="Vehicle 2" vehicleCategory="car">
        <ParameterDeclarations />
        <BoundingBox>
          <Center x="1.4" y="0.0" z="0.9" />
          <Dimensions width="2.0" length="5.0" height="1.8" />
        </BoundingBox>
        <Performance maxSpeed="70.0" maxDeceleration="10.0" maxAcceleration="10.0" />
        <Axles>
          <FrontAxle positionZ="0.4" trackWidth="1.68" positionX="2.98" maxSteering="0.5235987756" wheelDiameter="0.8" />
          <RearAxle positionZ="0.4" trackWidth="1.68" positionX="0.0" maxSteering="0.5235987756" wheelDiameter="0.8" />
        </Axles>
        <Properties />
      </Vehicle>
    </ScenarioObject>
    <ScenarioObject name="ApproachedStopline">
      <ExternalObjectReference name="9" />
    </ScenarioObject>
  </Entities>
  <Storyboard>
    <Init>
      <Actions>
        <Private entityRef="Vehicle 1">
          <PrivateAction>
            <TeleportAction>
              <Position>
                <LanePosition laneId="-1" offset="0" roadId="0" s="10">
                </LanePosition>
              </Position>
            </TeleportAction>
          </PrivateAction>
          <PrivateAction>
            <LongitudinalAction>
              <SpeedAction>
                <SpeedActionDynamics dynamicsDimension="time" dynamicsShape="step" value="0" />
                <SpeedActionTarget>
                  <AbsoluteTargetSpeed value="$VehicleSpeeds" />
                </SpeedActionTarget>
              </SpeedAction>
            </LongitudinalAction>
          </PrivateAction>
        </Private>
        <Private entityRef="Vehicle 2">
          <PrivateAction>
            <TeleportAction>
              <Position>
                <LanePosition laneId="1" offset="0" roadId="4" s="8">
                  <Orientation type="relative" h="${pi}" />
                </LanePosition>
              </Position>
            </TeleportAction>
          </PrivateAction>
        </Private>
      </Actions>
    </Init>
    <Story name="SwitchTrafficSignals">
      <Act name="SwitchToGreenUponArrival">
        <ManeuverGroup maximumExecutionCount="1" name="SwitchToGreenUponArrival">
          <Actors selectTriggeringEntities="false" />
          <Maneuver name="InitiateSwitchToGreen">
            <Event name="SwitchToIntermediateRedUponArrival" priority="override">
              <Action name="SwitchStraight">
                <GlobalAction>
                  <InfrastructureAction>
                    <TrafficSignalAction>
                      <TrafficSignalControllerAction trafficSignalControllerRef="straight" phase="intermediate_red" />
                    </TrafficSignalAction>
                  </InfrastructureAction>
                </GlobalAction>
              </Action>
              <Action name="SwitchTurn">
                <GlobalAction>
                  <InfrastructureAction>
                    <TrafficSignalAction>
                      <TrafficSignalControllerAction trafficSignalControllerRef="turn" phase="intermediate_to_red" />
                    </TrafficSignalAction>
                  </InfrastructureAction>
                </GlobalAction>
              </Action>
              <StartTrigger>
                <ConditionGroup>
                  <Condition name="ArrivalAtStopline" delay="0" conditionEdge="none">
                    <ByEntityCondition>
                      <TriggeringEntities triggeringEntitiesRule="any">
                        <EntityRef entityRef="Vehicle 1" />
                      </TriggeringEntities>
                      <EntityCondition>
                        <DistanceCondition freespace="true" value="60" rule="lessThan" relativeDistanceType="longitudinal">
                          <Position>
                            <RelativeObjectPosition entityRef="ApproachedStopline" dx="0" dy="0"></RelativeObjectPosition>
                          </Position>
                        </DistanceCondition>
                      </EntityCondition>
                    </ByEntityCondition>
                  </Condition>
                </ConditionGroup>
              </StartTrigger>
            </Event>
          </Maneuver>
        </ManeuverGroup>
      </Act>
      <Act name="MoveVehicle2">
        <ManeuverGroup maximumExecutionCount="1" name="MoveVehicle2">
          <Actors selectTriggeringEntities="false">
            <EntityRef entityRef="Vehicle 2" />
          </Actors>
          <Maneuver name="MoveAtGreen">
            <Event name="MoveAtGreen" priority="override">
              <Action name="Move">
                <PrivateAction>
                  <LongitudinalAction>
                    <SpeedAction>
                      <SpeedActionDynamics dynamicsDimension="time" dynamicsShape="sinusoidal" value="3" />
                      <SpeedActionTarget>
                        <AbsoluteTargetSpeed value="$VehicleSpeeds" />
                      </SpeedActionTarget>
                    </SpeedAction>
                  </LongitudinalAction>
                </PrivateAction>
                
              </Action>
              <StartTrigger>
                <ConditionGroup>
                  <Condition name="AtGreen" delay="0" conditionEdge="none">
                    <ByValueCondition>
                      <TrafficSignalControllerCondition trafficSignalControllerRef="straight" phase="green" />
                    </ByValueCondition>
                    
                  </Condition>
                </ConditionGroup>
              </StartTrigger>
            </Event>
          </Maneuver>
        </ManeuverGroup>
      </Act>
      <Act name="BreakTrafficLight">
        <ManeuverGroup name="BreakTrafficLight" maximumExecutionCount="1">
          <Actors selectTriggeringEntities="false"></Actors>
          <Maneuver name="BreakTrafficLight">
            <Event name="BreakTrafficLightAfterMovingVehicle2" priority="override">
              <Action name="TurnAllBulbsOn">
                <GlobalAction>
                  <InfrastructureAction>
                    <TrafficSignalAction>
                      <TrafficSignalStateAction name="3" state="$brokenState" />
                    </TrafficSignalAction>
                  </InfrastructureAction>
                </GlobalAction>
              </Action>
              <StartTrigger>
                <ConditionGroup>
                  <Condition name="AfterMovingVehicle2" delay="5" conditionEdge="none">
                    <ByValueCondition>
                      <StoryboardElementStateCondition storyboardElementType="act" storyboardElementRef="MoveVehicle2" state="completeState" />
                    </ByValueCondition>
                  </Condition>
                </ConditionGroup>
              </StartTrigger>
            </Event>
          </Maneuver>
        </ManeuverGroup>
      </Act>
    </Story>
    <StopTrigger>
      <ConditionGroup>
        <Condition name="EndAfterTrafficLightBroken" delay="5" conditionEdge="none">
          <ByValueCondition>
            <TrafficSignalCondition name="3" state="$brokenState" />
          </ByValueCondition>
        </Condition>
      </ConditionGroup>
    </StopTrigger>
  </Storyboard>
</OpenSCENARIO>